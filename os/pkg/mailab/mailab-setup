#!/bin/sh
# First boot: a human token for the kiosk and an rw token for one AI client,
# in /etc/mailab. Delete /etc/mailab/mailab.env and reboot to regenerate.
set -eu

host=${MAILAB_SETUP_HOST:-0.0.0.0}
dir=/etc/mailab

rand() {
	od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
}

umask 077
mkdir -p "$dir"
human=$(rand)
ai=$(rand)

cat > "$dir/mailab.env.tmp" <<END
# generated by mailab-setup $(date -Is); delete and reboot to regenerate.
# Put your own settings (MAILAB_RF_REGION, MOUSER_API_KEY, ...) in local.env.
HOST=$host
PORT=3000
MAILAB_TOKENS=kiosk:$human:human,claude:$ai:rw
END
chgrp mailab "$dir/mailab.env.tmp"
chmod 640 "$dir/mailab.env.tmp"

printf '%s\n' "$human" > "$dir/kiosk.token"
if getent group kiosk > /dev/null; then
	chgrp kiosk "$dir/kiosk.token"
	chmod 640 "$dir/kiosk.token"
fi

mv "$dir/mailab.env.tmp" "$dir/mailab.env"
