    {"id": "ch", "type": "channel", "params": {"snr_db": 14, "phase": 30}},
    {"id": "sync_tx", "type": "symbol_sync", "params": {"sps": 8}},
    {"id": "const_tx", "type": "constellation", "params": {"points": 1000}},
    {"id": "sync_rx", "type": "symbol_sync", "params": {"sps": 8}},
    {"id": "const_rx", "type": "constellation", "params": {"points": 1000}}
  ],
  "links": [["bits", "tx"], ["tx", "ch"], ["tx", "sync_tx"], ["sync_tx", "const_tx"], ["ch", "sync_rx"], ["sync_rx", "const_rx"]],
  "panes": [
    {"type": "trace", "title": "Before the channel", "config": {"traces": ["fg_const_tx"]}},
    {"type": "trace", "title": "After: 14 dB SNR, 30 deg", "config": {"traces": ["fg_const_rx"]}}
  ]
