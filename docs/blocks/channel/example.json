{
  "description": "The same QPSK signal before and after a channel with 14 dB SNR and a 30 degree phase rotation, both after symbol timing recovery.",
  "prompt": "Put a channel with 14 dB SNR and 30 degrees of phase rotation after a QPSK modulator and compare the constellations before and after.",
  "blocks": [
    {"id": "bits", "type": "bits", "params": {"pattern": "prbs9", "bitrate": 20000}},
