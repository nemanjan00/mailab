{
  "description": "A 1 kHz tone frequency-modulated with 5 kHz deviation at 48 kS/s: the Bessel-line spectrum, and the tone recovered by fm_demod.",
  "prompt": "FM-modulate a 1 kHz tone with 5 kHz deviation, show the spectrum and demodulate it again.",
  "blocks": [
    {"id": "tone", "type": "signal", "params": {"rate": 48000, "freq": 1000, "amp": 0.8, "noise": 0}},
    {"id": "fm", "type": "analog_mod", "params": {"mode": "fm", "deviation": 5000.0}},
    {"id": "spec", "type": "spectrum", "params": {"fft": 2048, "traces": ["avg"], "average": 16}},
    {"id": "demod", "type": "fm_demod", "params": {"deviation": 5000.0}},
    {"id": "scope", "type": "scope", "params": {"samples": 240, "measure": ["freq", "vpp"]}}
  ],
  "links": [["tone", "fm"], ["fm", "spec"], ["fm", "demod"], ["demod", "scope"]],
  "panes": [
    {"type": "trace", "title": "FM spectrum", "config": {"traces": ["fg_spec"]}},
    {"type": "trace", "title": "Demodulated tone", "config": {"traces": ["fg_scope"]}}
  ]
}
