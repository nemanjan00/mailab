{
  "description": "PRBS9 bits as 16-QAM: the transmitted spectrum and the constellation after symbol timing recovery.",
  "prompt": "Modulate a PRBS9 bit stream as 16-QAM at 8 samples per symbol and show the spectrum and constellation.",
  "blocks": [
    {"id": "bits", "type": "bits", "params": {"pattern": "prbs9", "bitrate": 40000}},
    {"id": "tx", "type": "mod", "params": {"scheme": "qam16", "sps": 8, "beta": 0.35}},
    {"id": "spec", "type": "spectrum", "params": {"fft": 1024, "traces": ["avg"], "average": 16}},
    {"id": "sync", "type": "symbol_sync", "params": {"sps": 8, "bandwidth": 0.01}},
    {"id": "const", "type": "constellation", "params": {"points": 2000}}
  ],
  "links": [["bits", "tx"], ["tx", "spec"], ["tx", "sync"], ["sync", "const"]],
  "panes": [
    {"type": "trace", "title": "Spectrum (avg)", "config": {"traces": ["fg_spec"]}},
    {"type": "trace", "title": "Constellation", "config": {"traces": ["fg_const"]}}
  ]
}
