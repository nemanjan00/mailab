{
  "description": "An FM test signal (1 kHz tone, 5 kHz deviation) through a 25 dB SNR channel, demodulated: scope with frequency measurement, and audio.",
  "prompt": "Demodulate the FM signal and let me hear it; show the recovered audio on a scope.",
  "template": {"name": "sdr_fm_audio", "args": {"args": "driver=rtlsdr", "freq": 145500000.0}},
  "blocks": [
    {"id": "tone", "type": "signal", "params": {"rate": 48000, "freq": 1000, "amp": 0.8, "noise": 0}},
    {"id": "fm", "type": "analog_mod", "params": {"mode": "fm", "deviation": 5000.0}},
    {"id": "ch", "type": "channel", "params": {"snr_db": 25}},
    {"id": "demod", "type": "fm_demod", "params": {"deviation": 5000.0}},
    {"id": "scope", "type": "scope", "params": {"samples": 240, "measure": ["freq", "vpp"]}},
    {"id": "out", "type": "audio", "params": {"rate": 48000, "gain": 0.5}}
  ],
  "links": [["tone", "fm"], ["fm", "ch"], ["ch", "demod"], ["demod", "scope"], ["demod", "out"]],
  "panes": [
    {"type": "trace", "title": "Demodulated audio", "config": {"traces": ["fg_scope"]}, "w": 8},
    {"type": "audio", "title": "Audio", "config": {"stream": "fg_out"}, "w": 4}
  ]
}
