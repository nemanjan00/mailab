{
	"name": "mailab",
	"version": "0.1.0",
	"description": "mAI lab: MCP server + live web UI for a hardware lab the AI operates",
	"main": "src/index.js",
	"repository": "git@github.com:nemanjan00/mailab.git",
	"author": "Nemanja Nedeljkovic <nemanjan00@gmail.com>",
	"license": "MIT",
	"scripts": {
		"web": "yarn build && forever src",
		"watch": "esbuild public/app.js --bundle --format=esm --outdir=public/build --sourcemap --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --watch=forever & nodemon src",
		"lint": "eslint src/ bin/ public/",
		"test": "jest",
		"test:watch": "jest --watch",
		"prepare": "husky",
		"channel": "node bin/channel.js",
		"block-docs": "node bin/block-docs.js",
		"block-shots": "node bin/block-shots.js",
		"build": "esbuild public/app.js --bundle --format=esm --outdir=public/build --sourcemap --minify --loader:.woff2=file --loader:.woff=file --loader:.ttf=file"
	},
	"jest": {
		"testEnvironment": "node",
		"forceExit": true,
		"modulePathIgnorePatterns": [
			"<rootDir>/.claude/"
		],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"<rootDir>/.claude/"
		]
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"nodemonConfig": {
		"ignore": [
			"data/*",
			"public/*"
		]
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@nemanjan00/qrp": "^0.13.1",
		"@novnc/novnc": "^1.7.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"express": "^5.3.0",
		"forever": "^4.0.3",
		"gridstack": "^14.1.0",
		"icom-ci-v": "0.0.1",
		"js-yaml": "^5.5.0",
		"kaitai-struct": "^0.11.0",
		"kaitai-struct-compiler": "^0.11.0",
		"katex": "^0.19.1",
		"kc9531b": "^0.0.3",
		"marked": "^18.2.1",
		"mathjs": "^15.2.0",
		"mdp-host": "0.1.0",
		"node-proxmark3": "^0.0.12",
		"serialport": "^13.0.0",
		"uplot": "^1.6.32",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/core": "^8.1.2",
		"@babel/eslint-parser": "^8.1.2",
		"@eslint/js": "^10.0.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.1",
		"nodemon": "^3.1.14",
		"supertest": "^7.3.2"
	}
}
